POSTGRES_DB=ai_document_assistant
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

STORAGE_DIRECTORY=storage/documents
MAX_UPLOAD_SIZE_MB=10

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE_SECONDS=1800
OLLAMA_LLM_NUM_CTX=8192
# 0 = embedding CPU'da çalışır; 8 GB GPU'da LLM ile birlikte sığmadığı için önerilir. Satır silinirse Ollama karar verir.
OLLAMA_EMBEDDING_NUM_GPU=0
OLLAMA_EMBEDDING_BATCH_SIZE=16
OLLAMA_EMBEDDING_MAX_RETRIES=3
OLLAMA_EMBEDDING_RETRY_DELAY_SECONDS=1
RETRIEVAL_MIN_SIMILARITY=0.35
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
